<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE task PUBLIC "-//OASIS//DTD DITA Task//EN" "task.dtd">
<task id="task_loading_corpus_files" audience="novice">
    <title>Loading Individual Corpus Files</title>
    <shortdesc>You can select which corpus files should be loaded in AntConc</shortdesc>
    <prolog>
        <author>Nikita Apraj</author>
        <critdates>
            <created date="11/29/2016"/>
        </critdates>
    
    <metadata>
        <keywords>
            <indexterm>load files</indexterm>
            <indexterm>load folder</indexterm>
        </keywords>
    </metadata>
    </prolog>
    
    <taskbody>
        <context>
            <p>To load corpus files -</p>
        </context>
        <steps>
            <step>
                <cmd>Go to <uicontrol>File</uicontrol> > <uicontrol>Open file(s)</uicontrol></cmd>
                <info>
                    <image href="Loading_files.png" align="left" height="300px"></image>
                </info>
            </step>
            <step>
                <cmd>Select the file(s) you want to work with and click <uicontrol>Open</uicontrol>.</cmd>
            </step>
        </steps>
        <result id="loaded_corpus">Desired files will appear in Corpus Files pane on the left.
            <note type="tip">Open any of the loaded files in <xref href="Concept12_File_View_Tool.dita">File View</xref> to ensure that corpus files are loaded correctly.</note>
        </result>
    </taskbody>
</task>
